# API Configuration
# For local development, use https://localhost:3002 with self-signed cert
# For production, always use HTTPS
REACT_APP_API_URL=https://localhost:3002

# Payment Configuration
# NEVER commit real credentials to version control
# Use environment-specific values
REACT_APP_PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID

# Security Notice:
# - Always use HTTPS in production
# - Never commit real API keys or secrets
# - Use environment variables from your deployment platform
# - Keep this file as a template only